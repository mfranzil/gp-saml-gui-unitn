#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PID_FILE="${REPO_DIR}/gp-saml-gui.pid"
LOG_FILE="${REPO_DIR}/gp-saml-gui.log"
PYTHON_GLOB=("${REPO_DIR}"/.direnv/*/bin/python3)
VPNC_SCRIPT="${SCRIPT_DIR}/gp-saml-vpnc-script"
HIP_SCRIPT="/opt/homebrew/opt/openconnect/libexec/openconnect/hipreport.sh"
VPN_HOST="vpn-mfa.icts.unitn.it"

usage() {
    cat <<'EOF'
Usage: gp-saml-gui-unitn {start|stop|status|restart|logs}
EOF
}

python_bin() {
    if [ ${#PYTHON_GLOB[@]} -eq 0 ] || [ ! -x "${PYTHON_GLOB[0]}" ]; then
        echo "Missing Python virtual environment under ${REPO_DIR}/.direnv" >&2
        exit 1
    fi

    printf '%s\n' "${PYTHON_GLOB[0]}"
}

read_pid() {
    if [ ! -f "$PID_FILE" ]; then
        return 1
    fi

    tr -d '[:space:]' < "$PID_FILE"
}

is_running() {
    local pid

    pid="$(read_pid)" || return 1
    [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1
}

clear_stale_pid() {
    if [ -f "$PID_FILE" ] && ! is_running; then
        rm -f "$PID_FILE"
    fi
}

start_vpn() {
    local python

    clear_stale_pid
    if is_running; then
        echo "gp-saml-gui is already running with PID $(read_pid)" >&2
        exit 1
    fi

    python="$(python_bin)"
    if [ ! -x "$HIP_SCRIPT" ]; then
        echo "Missing HIP helper: $HIP_SCRIPT" >&2
        exit 1
    fi
    : > "$LOG_FILE"

    cd "$REPO_DIR"
    "$python" gp_saml_gui.py \
        --pywebview \
        --clientos=Mac \
        --allow-insecure-crypto \
        "$VPN_HOST" \
        --sudo-openconnect \
        -- \
        --background \
        "--pid-file=$PID_FILE" \
        "--script=$VPNC_SCRIPT" \
        "--csd-wrapper=$HIP_SCRIPT" \
        >> "$LOG_FILE" 2>&1

    echo "gp-saml-gui started with PID $(read_pid)"
}

stop_vpn() {
    local pid

    if ! is_running; then
        clear_stale_pid
        exit 1
    fi

    pid="$(read_pid)"
    sudo kill "$pid"
    sudo rm -f "$PID_FILE"

    echo "gp-saml-gui with PID $pid stopped"
}

status_vpn() {
    local pid
    local configured

    if ! is_running; then
        clear_stale_pid
        exit 1
    fi

    pid="$(read_pid)"
    echo "Connected (pid $pid)"
    if [ -f "$LOG_FILE" ]; then
        configured="$(grep -E 'Configured as ' "$LOG_FILE" | tail -n 1 || true)"
        if [ -n "$configured" ]; then
            echo "$configured"
        fi
    fi
}

show_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -n 80 "$LOG_FILE"
    else
        echo "No log file at $LOG_FILE" >&2
        exit 1
    fi
}

case "${1:-}" in
    start)
        start_vpn
        ;;
    stop)
        stop_vpn
        ;;
    status)
        status_vpn
        ;;
    restart)
        stop_vpn || true
        start_vpn
        ;;
    logs)
        show_logs
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac