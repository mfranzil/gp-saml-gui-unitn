#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gp-saml-gui"
PID_FILE="${STATE_DIR}/gp-saml-gui.pid"
LOG_FILE="${STATE_DIR}/gp-saml-gui.log"
PYTHON_BIN="${GP_SAML_GUI_PYTHON:-}"
VPNC_SCRIPT="${REPO_DIR}/libexec/gp-saml-vpnc-script"
HIP_SCRIPT="${GP_SAML_GUI_HIP_REPORT:-}"
CLIENTOS="${GP_SAML_GUI_CLIENTOS:-Mac}"
VPN_HOST="vpn-mfa.icts.unitn.it"

usage() {
    cat <<'EOF_USAGE'
Usage: gp-saml-gui-unitn {start|stop|status|restart|logs}

Optional environment variables:
  GP_SAML_GUI_PYTHON       Python executable or command
  GP_SAML_GUI_HIP_REPORT   path to OpenConnect hipreport.sh
  GP_SAML_GUI_VPNC_SCRIPT  path to the real vpnc-script
  GP_SAML_GUI_CLIENTOS     GlobalProtect client OS (Mac, Linux, Windows; default: Mac)
EOF_USAGE
}

python_bin() {
    local candidate

    if [ -n "$PYTHON_BIN" ]; then
        if [ -x "$PYTHON_BIN" ]; then
            printf '%s\n' "$PYTHON_BIN"
            return
        fi
        if command -v "$PYTHON_BIN" >/dev/null 2>&1; then
            command -v "$PYTHON_BIN"
            return
        fi
        echo "Python executable is not usable: $PYTHON_BIN" >&2
        exit 1
    fi

    for candidate in "${REPO_DIR}/.venv/bin/python3" "${REPO_DIR}"/.direnv/*/bin/python3; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    if command -v python3 >/dev/null 2>&1; then
        command -v python3
        return
    fi
    echo "Python 3 not found. Set GP_SAML_GUI_PYTHON to its executable path or command." >&2
    exit 1
}

find_hip_script() {
    local candidate brew brew_prefix

    if [ -n "$HIP_SCRIPT" ]; then
        [ -x "$HIP_SCRIPT" ] && { printf '%s\n' "$HIP_SCRIPT"; return; }
        echo "HIP helper is not executable: $HIP_SCRIPT" >&2
        exit 1
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        for brew in "$(command -v brew 2>/dev/null || true)" /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [ -n "$brew" ] && [ -x "$brew" ]; then
                brew_prefix="$("$brew" --prefix openconnect 2>/dev/null || true)"
                candidate="${brew_prefix}/libexec/openconnect/hipreport.sh"
                if [ -n "$brew_prefix" ] && [ -x "$candidate" ]; then
                    printf '%s\n' "$candidate"
                    return
                fi
            fi
        done
    fi

    for candidate in \
            /opt/homebrew/opt/openconnect/libexec/openconnect/hipreport.sh \
            /usr/local/opt/openconnect/libexec/openconnect/hipreport.sh \
            /usr/libexec/openconnect/hipreport.sh \
            /usr/lib/openconnect/hipreport.sh; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    echo "Cannot find OpenConnect hipreport.sh; set GP_SAML_GUI_HIP_REPORT." >&2
    exit 1
}

# hipreport.sh reads the macOS version from sw_vers.
# If not on macOS it falls back to
# 10.16.0, and the gateway then admits the client with DNS-only access.
# why this happens, I do not know. But macOS 10.16.0 is from 2020 and 
# well past its end-of-life, so the gateway may have disabled it.
# This wrapper just puts a sw_vers that reports a current version (15.6.1) instead.
mac_hip_wrapper() {
    local real="$1" dir="${STATE_DIR}/hip"

    mkdir -p "$dir"
    printf '#!/bin/sh\necho 15.6.1\n' > "${dir}/sw_vers"
    printf '#!/bin/sh\nPATH=%s:"$PATH" exec %s "$@"\n' \
        "$(shell_quote "$dir")" "$(shell_quote "$real")" > "${dir}/hipreport.sh"
    chmod 755 "${dir}/sw_vers" "${dir}/hipreport.sh"
    printf '%s\n' "${dir}/hipreport.sh"
}

shell_quote() {
    # OpenConnect executes --script as a /bin/sh command line.
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

check_runtime() {
    local python="$1"

    if ! command -v openconnect >/dev/null 2>&1; then
        echo "OpenConnect not found in PATH." >&2
        exit 1
    fi

    if ! "$python" - <<'PY' >/dev/null 2>&1
import sys
if sys.version_info < (3, 8):
    raise SystemExit(1)
import requests
import webview
PY
    then
        cat >&2 <<'EOF_ERROR'
Python is missing the UniTN helper runtime dependencies (Python >= 3.8,
requests and pywebview). Follow the UniTN installation section in README.md
or select another environment with GP_SAML_GUI_PYTHON.
EOF_ERROR
        exit 1
    fi
}

validate_clientos() {
    case "$CLIENTOS" in
        Mac|Linux|Windows)
            ;;
        *)
            echo "Invalid GP_SAML_GUI_CLIENTOS: $CLIENTOS (expected Mac, Linux, or Windows)" >&2
            exit 1
            ;;
    esac
}

read_pid() {
    if [ ! -f "$PID_FILE" ]; then
        return 1
    fi

    tr -d '[:space:]' < "$PID_FILE"
}

is_running() {
    local pid

    pid="$(read_pid)" || return 1
    [ -n "$pid" ] && ps -p "$pid" >/dev/null 2>&1
}

clear_stale_pid() {
    if [ -f "$PID_FILE" ] && ! is_running; then
        rm -f "$PID_FILE"
    fi
}

start_vpn() {
    local python hip_script vpnc_script_cmd

    clear_stale_pid
    if is_running; then
        echo "gp-saml-gui is already running with PID $(read_pid)" >&2
        exit 1
    fi

    python="$(python_bin)"
    hip_script="$(find_hip_script)"
    validate_clientos
    if [ "$CLIENTOS" = "Mac" ] && [ "$(uname -s)" != "Darwin" ]; then
        hip_script="$(mac_hip_wrapper "$hip_script")"
    fi
    check_runtime "$python"

    vpnc_script_cmd="$(shell_quote "$VPNC_SCRIPT")"
    if [ -n "${GP_SAML_GUI_VPNC_SCRIPT:-}" ]; then
        if [ ! -x "$GP_SAML_GUI_VPNC_SCRIPT" ]; then
            echo "vpnc-script is not executable: $GP_SAML_GUI_VPNC_SCRIPT" >&2
            exit 1
        fi
        vpnc_script_cmd="GP_SAML_GUI_VPNC_SCRIPT=$(shell_quote "$GP_SAML_GUI_VPNC_SCRIPT") $vpnc_script_cmd"
    fi

    mkdir -p "$STATE_DIR"
    : > "$LOG_FILE"

    cd "$REPO_DIR"
    "$python" gp_saml_gui.py \
        --pywebview \
        --gateway \
        "--clientos=$CLIENTOS" \
        --allow-insecure-crypto \
        --sudo-openconnect \
        "$VPN_HOST" \
        -- \
        --background \
        "--pid-file=$PID_FILE" \
        "--script=$vpnc_script_cmd" \
        "--csd-wrapper=$hip_script" \
        >> "$LOG_FILE" 2>&1

    echo "gp-saml-gui started with PID $(read_pid)"
}

stop_vpn() {
    local pid

    if ! is_running; then
        clear_stale_pid
        exit 1
    fi

    pid="$(read_pid)"
    sudo kill "$pid"
    sudo rm -f "$PID_FILE"

    echo "gp-saml-gui with PID $pid stopped"
}

status_vpn() {
    local pid
    local configured

    if ! is_running; then
        clear_stale_pid
        exit 1
    fi

    pid="$(read_pid)"
    echo "Connected (pid $pid)"
    if [ -f "$LOG_FILE" ]; then
        configured="$(grep -E 'Configured as ' "$LOG_FILE" | tail -n 1 || true)"
        if [ -n "$configured" ]; then
            echo "$configured"
        fi
    fi
}

show_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -n 80 "$LOG_FILE"
    else
        echo "No log file at $LOG_FILE" >&2
        exit 1
    fi
}

case "${1:-}" in
    start)
        start_vpn
        ;;
    stop)
        stop_vpn
        ;;
    status)
        status_vpn
        ;;
    restart)
        stop_vpn || true
        start_vpn
        ;;
    logs)
        show_logs
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
