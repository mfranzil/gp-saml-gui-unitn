#!/bin/sh

set -eu

find_vpnc_script() {
    candidate="${GP_SAML_GUI_VPNC_SCRIPT:-}"
    if [ -n "$candidate" ]; then
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
        echo "Configured vpnc-script is not executable: $candidate" >&2
        exit 1
    fi

    if [ "$(uname -s)" = "Darwin" ]; then
        for brew in "$(command -v brew 2>/dev/null || true)" /opt/homebrew/bin/brew /usr/local/bin/brew; do
            if [ -x "$brew" ]; then
                brew_prefix="$("$brew" --prefix 2>/dev/null || true)"
                candidate="${brew_prefix}/etc/vpnc/vpnc-script"
                if [ -n "$brew_prefix" ] && [ -x "$candidate" ]; then
                    printf '%s\n' "$candidate"
                    return
                fi
            fi
        done
        for candidate in /opt/homebrew/etc/vpnc/vpnc-script /usr/local/etc/vpnc/vpnc-script; do
            if [ -x "$candidate" ]; then
                printf '%s\n' "$candidate"
                return
            fi
        done
    else
        for candidate in /etc/vpnc/vpnc-script /usr/share/vpnc-scripts/vpnc-script /usr/share/vpnc/vpnc-script; do
            if [ -x "$candidate" ]; then
                printf '%s\n' "$candidate"
                return
            fi
        done
        if command -v vpnc-script >/dev/null 2>&1; then
            command -v vpnc-script
            return
        fi
    fi

    echo "Cannot find executable vpnc-script." >&2
    exit 1
}

REAL_VPNC_SCRIPT="$(find_vpnc_script)"

active_network_service() {
    active_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')"
    if [ -z "${active_interface:-}" ]; then
        return 1
    fi

    /usr/sbin/networksetup -listnetworkserviceorder | awk -v iface="$active_interface" '
        previous && $0 ~ "Device: " iface "\\)" {
            sub(/^[[:space:]]*\([0-9]+\)[[:space:]]*/, "", previous)
            print previous
            exit
        }
        { previous = $0 }
    '
}

# Both the system vpnc-script and apply_dns_fallback set the service's DNS
# servers with networksetup, and the system script resets them to "Empty" on
# disconnect. Save the service and its servers before either runs, and put them
# back afterwards.
DNS_BACKUP="/var/run/gp-saml-gui/dns"

save_dns() {
    [ ! -e "$DNS_BACKUP" ] || return 0
    service="$(active_network_service || true)"
    [ -n "${service:-}" ] || return 0
    mkdir -p "$(dirname "$DNS_BACKUP")"
    {
        printf '%s\n' "$service"
        /usr/sbin/networksetup -getdnsservers "$service" | grep -E '^[0-9a-fA-F:.]+$' || echo Empty
    } >"$DNS_BACKUP"
}

apply_dns_fallback() {
    service="$(active_network_service || true)"
    if [ -n "${service:-}" ] && [ -n "${INTERNAL_IP4_DNS:-}" ]; then
        /usr/sbin/networksetup -setdnsservers "$service" ${INTERNAL_IP4_DNS} >/dev/null 2>&1 || true
    fi
}

restore_dns() {
    [ -e "$DNS_BACKUP" ] || return 0
    service="$(head -n 1 "$DNS_BACKUP")"
    servers="$(tail -n +2 "$DNS_BACKUP")"
    /usr/sbin/networksetup -setdnsservers "$service" ${servers} >/dev/null 2>&1 || true
    rm -f "$DNS_BACKUP"
}

# When systemd-resolved is not running, vpnc-script with resolvconf leaves a
# broken /etc/resolv.conf while connected and an empty one after disconnecting.
# We keep a copy of the original, write the VPN servers directly, and restore it
# on exit.
RESOLV_BACKUP="/run/gp-saml-gui/resolv.conf"

uses_systemd_resolved() {
    [ -d /run/systemd/resolve ] && command -v resolvectl >/dev/null 2>&1
}

write_vpn_resolv_conf() {
    [ -n "${INTERNAL_IP4_DNS:-}" ] || return 0
    mkdir -p "$(dirname "$RESOLV_BACKUP")"
    if [ ! -e "$RESOLV_BACKUP" ] && [ ! -L "$RESOLV_BACKUP" ]; then
        cp -P /etc/resolv.conf "$RESOLV_BACKUP"
    fi
    rm -f /etc/resolv.conf
    {
        echo "# Generated by gp-saml-gui-unitn; restored on disconnect"
        [ -z "${CISCO_DEF_DOMAIN:-}" ] || echo "search ${CISCO_DEF_DOMAIN}"
        for server in ${INTERNAL_IP4_DNS}; do
            echo "nameserver ${server}"
        done
    } >/etc/resolv.conf
}

restore_resolv_conf() {
    if [ -e "$RESOLV_BACKUP" ] || [ -L "$RESOLV_BACKUP" ]; then
        rm -f /etc/resolv.conf
        cp -P "$RESOLV_BACKUP" /etc/resolv.conf
        rm -f "$RESOLV_BACKUP"
    fi
}

if [ "$(uname -s)" = "Darwin" ]; then
    case "${reason:-}" in
        connect)
            save_dns || true
            ;;
    esac
    if [ "${INTERNAL_IP4_NETMASKLEN:-}" = "32" ] || [ "${INTERNAL_IP4_NETMASK:-}" = "255.255.255.255" ]; then
        unset INTERNAL_IP4_NETADDR INTERNAL_IP4_NETMASK INTERNAL_IP4_NETMASKLEN
    fi
fi

"$REAL_VPNC_SCRIPT" "$@"
status=$?

if [ "$(uname -s)" = "Darwin" ]; then
    case "${reason:-}" in
        connect|reconnect|attempt-reconnect)
            apply_dns_fallback
            ;;
        disconnect)
            restore_dns
            ;;
    esac
elif ! uses_systemd_resolved; then
    case "${reason:-}" in
        connect|reconnect)
            write_vpn_resolv_conf || true
            ;;
        disconnect)
            restore_resolv_conf || true
            ;;
    esac
fi

exit "$status"
